LOG_LEVEL=INFO
CORS_ORIGINS=*
# Postgres DSN. When empty, DB / auth / authorization endpoints return 503.
# Local dev: `./dev.sh --db` starts a pgvector/pgvector:pg17 container named
# nomos-postgres on port 5433 and exports this DSN for you:
#   postgres://nomos:nomos@localhost:5433/nomos?sslmode=disable
DATABASE_URL=
# Per-user cap on the routes that call the LLM gateway (conversation
# messages, piece ingestion, runs, search). In-memory, so the cap applies per
# API pod. Unset, zero, and negative all fall back to 20.
LLM_RATE_LIMIT_PER_MINUTE=20

# Public origin of the app, used to build invitation accept links
# (<APP_BASE_URL>/accept-invite?token=...). Defaults to the dev front.
APP_BASE_URL=http://localhost:5173
# Email of the first admin. On boot the API grants this user the "admin"
# Casbin role once Better Auth has created the account. The account itself
# (with its password) is created by the front Node server — set the matching
# BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD in front/.env. Empty disables
# it.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Nomos — LLM gateway (OpenRouter, OpenAI-compatible). See docs/PLAN.md §12.
# Point OPENROUTER_BASE_URL elsewhere (a self-hosted vLLM, for instance) to
# move legal inference. OPENAI_API_KEY is accepted as a fallback for the key.
# Empty key → Nomos LLM services return 503.
# NEVER commit a real key — api/.env is gitignored.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing. The planner selects and parameterises a code-owned workflow
# (§4.1); the drafter writes grounded prose (slice 2); extraction qualifies
# pieces against a server-owned JSON schema; vision reads scanned pages.
PLANNER_MODEL=google/gemini-3.7-flash
EXTRACTION_MODEL=google/gemini-3.7-flash
DRAFTER_MODEL=google/gemini-3.7-flash
VISION_MODEL=anthropic/claude-haiku-5.5

# The web research loop (optional, off unless the composer's globe is on).
# The :online suffix is what enables OpenRouter's web plugin — WITHOUT IT the
# step is a model answering from memory and calling it a source, so the step
# refuses to run. Note that the plugin hands the query to a third-party search
# backend that is NOT an OpenRouter provider: it is covered by neither
# `data_collection: deny` nor OPENROUTER_PROVIDER_ALLOWLIST. Only short,
# model-written questions of law are ever sent (services/research_web.go).
WEB_SEARCH_MODEL=google/gemini-3.7-flash:online

# Retrieval. EMBEDDING_DIMS is baked into the halfvec(N) column type: changing
# it is a new column plus a dual-read reindex, never a config flip (§9.1).
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536
RERANK_MODEL=cohere/rerank-4-fast

# Remote vision OCR. OFF by default: local tesseract is the default processing
# mode and remote vision is an admin-enabled, allowlisted route (§7.2). When on,
# scans are read by VISION_MODEL in page ranges sent as PDFs, on the llm pool;
# a page the model does not return falls back to local tesseract.
# Accepted truthy values: 1/true/yes/on.
VISION_OCR_ENABLED=false

# PISTE OAuth2 client credentials (Légifrance + Judilibre). Empty disables the
# corpus connectors. Register on piste.gouv.fr and accept the CGU for both.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# Sandbox and production are SEPARATE environments on PISTE: separate
# credentials, separate hosts, and a sandbox token is rejected in production.
# Empty → the production defaults compiled into api/connectors. For sandbox:
#   PISTE_TOKEN_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
#   LEGIFRANCE_BASE_URL=https://sandbox-api.piste.gouv.fr/dila/legifrance/lf-engine-app
#   JUDILIBRE_BASE_URL=https://sandbox-api.piste.gouv.fr/cassation/judilibre/v1.0
PISTE_TOKEN_URL=
LEGIFRANCE_BASE_URL=
JUDILIBRE_BASE_URL=

# Corpus sources loaded at boot when they are not already loaded, so a fresh
# cluster comes up with a usable corpus instead of an empty one. Comma
# separated; empty disables it. The load runs in the background (it never
# delays readiness), resumes from its cursor after a restart, and only one
# replica can hold a source at a time. A source already loaded, not
# implemented, or without credentials logs one line and is skipped.
# This is a bounded exception to "loading the corpus is an admin action" —
# it holds only while the corpus stays at the one-practice-area scope of
# docs/PLAN.md §5.3 (~700 chunks, ~45s). Watch the chunk count.
CORPUS_AUTOSEED_SOURCES=legifrance

# Differentiated workflow-runner pools, per pod (§4.2). One shared pool would
# let a CPU-bound OCR step starve cheap DB transitions and let a 3-minute LLM
# call queue ahead of them. Non-positive values fall back to these defaults.
#
# The llm pool is what an upload waits on: chunk_and_embed then qualify_piece
# run there, two steps per pièce, so a 20-file batch is 40 network-bound calls.
# It is sized above the others because those calls are waiting, not computing —
# lower it if the gateway rate-limits.
STEP_CONCURRENCY_OCR=1
STEP_CONCURRENCY_RENDER=1
STEP_CONCURRENCY_LLM=4
STEP_CONCURRENCY_DB=8

# ---------------------------------------------------------------------------
# Object storage. Nomos writes every dossier object through utils.Blob, whose
# backend is chosen at boot (docs/PLAN.md §7.1):
#   S3 keys present  → the shared private bucket, keys under
#                      <APP_NAME>/<tenant>/<dossier>/..., presigned downloads
#   S3 keys empty    → a local filesystem backend rooted at api/tmp/blobs, so
#                      ingestion/OCR/export are testable with no credentials.
#                      Development only: not durable, not shared across pods.
# S3 needs the endpoint, the bucket and both keys; any of them empty selects the
# local backend. APP_NAME is the hard key prefix. Locally it falls back to
# "app".
# ---------------------------------------------------------------------------
APP_NAME=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# External CLIs, invoked through utils.RunTool (never a shell string). They
# ship in api/Dockerfile; install them locally to exercise the same paths:
#   macOS  brew install poppler tesseract tesseract-lang pandoc
#   alpine apk add poppler-utils tesseract-ocr tesseract-ocr-data-fra pandoc-cli
# A missing binary is reported as 503 "<tool> not available", never a crash.
# Only the French traineddata is installed in the image: always pass -l fra.
# ---------------------------------------------------------------------------
