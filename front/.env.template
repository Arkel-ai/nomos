# Postgres DSN — used by Better Auth (server-side) and shared with the Go
# API. Local dev example:
#   postgres://postgres:postgres@localhost:5432/app?sslmode=disable
DATABASE_URL=

# Better Auth server config (server-only — never PUBLIC_).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used for cookie domain / callbacks).
BETTER_AUTH_URL=http://localhost:5173

# Bootstrap admin, created on Node-server boot when Postgres is available.
# The Go API grants this email the "admin" role (set the same
# BOOTSTRAP_ADMIN_EMAIL in api/.env). Signup is invite-only; this is the one
# seeded account.
# These defaults are for local use; leave either empty to skip seeding. In
# production, inject your own (a random password) as a secret.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=NOMOS2026
